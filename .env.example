# Local backend/database configuration.
# Copy to .env for local development only. Never commit real secrets.

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

APP_FRONTEND_URL=
APP_CORS_ALLOWED_ORIGINS=
APP_SECURITY_JWT_SECRET=

# Email is disabled by default. Enable only after configuring a verified sender.
APP_MAIL_ENABLED=
APP_MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=
SPRING_MAIL_SMTP_STARTTLS=

# Google Calendar / Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_FRONTEND_URL=
GOOGLE_MOBILE_RETURN_URL=n
SOCIAL_GOOGLE_CLIENT_IDS=
SOCIAL_APPLE_CLIENT_IDS=

# Apple Push Notifications (APNs). Key ID/Team ID come from Apple Developer > Certificates,
# Identifiers & Profiles > Keys. APNS_AUTH_KEY_BASE64 is `base64 -i AuthKey_XXXX.p8` — never
# commit the raw .p8 file. Leave blank to disable push sending (safe no-op).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY_BASE64=
APNS_BUNDLE_ID=no.kollekt.app
APNS_PRODUCTION=false
