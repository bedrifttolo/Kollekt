# Local backend/database configuration.
# Copy to .env for local development only. Never commit real secrets.

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

APP_FRONTEND_URL=
APP_CORS_ALLOWED_ORIGINS=
APP_SECURITY_JWT_SECRET=

# Email is disabled by default. Enable only after configuring a verified sender.
APP_MAIL_ENABLED=
APP_MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=
SPRING_MAIL_SMTP_STARTTLS=

# Google Calendar / Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_FRONTEND_URL=
GOOGLE_MOBILE_RETURN_URL=n
SOCIAL_GOOGLE_CLIENT_IDS=
SOCIAL_APPLE_CLIENT_IDS=

# Apple Push Notifications (APNs). Key ID/Team ID come from Apple Developer > Certificates,
# Identifiers & Profiles > Keys. APNS_AUTH_KEY_BASE64 is `base64 -i AuthKey_XXXX.p8` — never
# commit the raw .p8 file. Leave blank to disable push sending (safe no-op).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY_BASE64=
APNS_BUNDLE_ID=no.kollekt.app
APNS_PRODUCTION=false

# Firebase Cloud Messaging (Android push). Firebase Console > Project settings > Service
# accounts > Generate new private key, then `base64 -i service-account.json`. Leave blank to
# disable Android push sending (safe no-op) — see release/ANDROID_RELEASE_SETUP.md.
FCM_CREDENTIALS_BASE64=

# App version gating for the in-app update prompt. Bump APP_VERSION_LATEST_IOS only once Apple has
# actually released the build (see the comment in application.yml). The MIN_* floors make the prompt
# non-dismissable below that version — leave them at 0 unless you deliberately want to lock old
# builds out. The ANDROID values stay at 0 until the Play listing is live.
APP_VERSION_LATEST_IOS=1.1
APP_VERSION_MIN_IOS=0
APP_VERSION_LATEST_ANDROID=0
APP_VERSION_MIN_ANDROID=0

# Second factor for /api/admin/* (which also needs a normal authenticated JWT). Used to fire the
# one-shot "a new version is out" push broadcast. Leave blank to make those endpoints 404.
APP_ADMIN_TOKEN=

# Image moderation (Google Cloud Vision SafeSearch). Every chat image / task feedback / task
# completion photo upload is checked here before it's stored. Get a key from a Google Cloud
# project with the Vision API enabled (APIs & Services > Credentials). Unlike the push gateways
# above, leaving this blank does NOT safely no-op — it FAILS CLOSED, rejecting every image
# upload, because unmoderated image sharing is not an acceptable default. Only set
# APP_MODERATION_ENABLED=false for local development if you don't want to configure a key yet;
# never set it false in production.
GOOGLE_CLOUD_VISION_API_KEY=
APP_MODERATION_ENABLED=
