# Mobile build configuration.
# Copy to .env.mobile before running npm run build:mobile / mobile:sync.
# Use deployed HTTPS services; mobile builds intentionally reject placeholders.

VITE_API_URL=

# Social-login client IDs. These are now the ONLY way into the app, so at least one
# provider must be configured or the login screen has no working button.
# VITE_APPLE_CLIENT_ID is the iOS bundle id on native and an Apple *Services ID* on the web.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# Published Terms of Use / Privacy Policy. Both are linked from the login screen and are
# required by App Store review. Defaults live in src/lib/legalLinks.ts.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Ads are off by default. Only enable after AdMob IDs and privacy disclosures are ready.
VITE_ENABLE_ADS=
VITE_ADMOB_HOME_BANNER_IOS=
VITE_ADMOB_HOME_BANNER_ANDROID=

# RevenueCat public SDK key for the iOS app (Project settings > API keys > Apple App
# Store in the RevenueCat dashboard). Safe to embed in the client build — it is not a
# secret. Leave blank to keep the lifetime-unlock paywall inert (see REVENUECAT_SETUP.md).
VITE_REVENUECAT_API_KEY_IOS=

# Kollekt game's alcohol-content variant (original "drink N sips" wording, kept only in this
# repo's git history and behind this flag). MUST stay unset for any App Store build — leaving
# it off means the alcohol strings never even ship in the bundle, not just hidden in the UI.
# Only set this for a build that isn't going through Apple review.
VITE_ENABLE_ALCOHOL_MODE=
