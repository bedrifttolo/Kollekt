# Public HTTPS services used by Android and iOS builds.
VITE_API_URL=https://api.invalid/api

# Public OAuth client identifiers. Google iOS is shown only when its dedicated
# client ID and Apple Sign In are both configured.
VITE_GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_IOS_CLIENT_ID=replace-with-google-ios-client-id.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=no.kollekt.app
