# Mobile build configuration.
# Copy to .env.mobile before running npm run build:mobile / mobile:sync.
# Use deployed HTTPS services; mobile builds intentionally reject placeholders.

VITE_API_URL=

# Optional social-login client IDs.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# Ads are off by default. Only enable after AdMob IDs and privacy disclosures are ready.
VITE_ENABLE_ADS=
VITE_ADMOB_HOME_BANNER_IOS=
VITE_ADMOB_HOME_BANNER_ANDROID=

# Debug only.
VITE_DEBUG_PUSH=
